 }
 
+/*
+ * An ISO/IEC 14496-30 WebVTT sample is a list of boxes: a 'vttc' for each cue
+ * shown during the sample, with its text in 'payl' and an optional identifier
+ * ('iden') and settings ('sttg'), or a 'vtte' when no cue is shown. A WebVTT
+ * packet carries one cue's text with its identifier and settings as side data,
+ * so the cues' texts are joined by line breaks and the first cue's identifier
+ * and settings are kept. A sample without cues gives an empty packet.
+ */
+static int get_wvtt_packet(AVIOContext *pb, AVPacket *pkt, int src_size)
+{
+    const uint8_t *iden = NULL, *sttg = NULL;
+    int iden_size = 0, sttg_size = 0, text_size = 0, cues = 0;
+    int64_t pos = avio_tell(pb);
+    uint8_t *buf, *out;
+    int ret;
+
+    buf = av_malloc(src_size);
+    if (!buf)
+        return AVERROR(ENOMEM);
+    ret = ffio_read_size(pb, buf, src_size);
+    if (ret < 0)
+        goto end;
+
+    /* Two passes over the boxes: one to size the packet, one to fill it. */
+    out = NULL;
+    for (int pass = 0; pass < 2; pass++) {
+        const uint8_t *p = buf, *end = buf + src_size;
+        int written = 0;
+
+        if (pass == 1) {
+            ret = av_new_packet(pkt, text_size);
+            if (ret < 0)
+                goto end;
+            pkt->pos = pos;
+            out = pkt->data;
+        }
+        while (end - p >= 8) {
+            uint32_t box_size = AV_RB32(p), box_type = AV_RB32(p + 4);
+            const uint8_t *child = p + 8, *cue_end = p + box_size;
+
+            if (box_size < 8 || box_size > end - p) {
+                ret = AVERROR_INVALIDDATA;
+                goto end;
+            }
+            if (box_type == MKBETAG('v','t','t','c')) {
+                if (pass == 0)
+                    cues++;
+                while (cue_end - child >= 8) {
+                    uint32_t child_size = AV_RB32(child), child_type = AV_RB32(child + 4);
+                    const uint8_t *data = child + 8;
+                    int data_size = child_size - 8;
+
+                    if (child_size < 8 || child_size > cue_end - child) {
+                        ret = AVERROR_INVALIDDATA;
+                        goto end;
+                    }
+                    if (child_type == MKBETAG('p','a','y','l')) {
+                        if (pass == 0) {
+                            if (text_size > INT_MAX - data_size - 1) {
+                                ret = AVERROR_INVALIDDATA;
+                                goto end;
+                            }
+                            text_size += (text_size ? 1 : 0) + data_size;
+                        } else {
+                            if (written)
+                                out[written++] = '\n';
+                            memcpy(out + written, data, data_size);
+                            written += data_size;
+                        }
+                    } else if (pass == 0 && cues == 1 && child_type == MKBETAG('i','d','e','n')) {
+                        iden = data;
+                        iden_size = data_size;
+                    } else if (pass == 0 && cues == 1 && child_type == MKBETAG('s','t','t','g')) {
+                        sttg = data;
+                        sttg_size = data_size;
+                    }
+                    child += child_size;
+                }
+            }
+            p += box_size;
+        }
+    }
+
+    if (iden_size > 0) {
+        uint8_t *side = av_packet_new_side_data(pkt, AV_PKT_DATA_WEBVTT_IDENTIFIER, iden_size);
+        if (!side) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        memcpy(side, iden, iden_size);
+    }
+    if (sttg_size > 0) {
+        uint8_t *side = av_packet_new_side_data(pkt, AV_PKT_DATA_WEBVTT_SETTINGS, sttg_size);
+        if (!side) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        memcpy(side, sttg, sttg_size);
+    }
+    ret = 0;
+
+end:
+    if (ret < 0)
+        av_packet_unref(pkt);
+    av_free(buf);
+    return ret;
+}
